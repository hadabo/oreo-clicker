{
  "name": "oreo-clicker",
  "version": "1.0.0",
  "description": "a tiny react game",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadabo/oreo-clicker.git"
  },
  "keywords": [
    "react",
    "game",
    "oreo",
    "cookieclicker"
  ],
  "author": "Abdul-hadi Hawari <hadabo@gmail.com> (http://hadabo.com/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hadabo/oreo-clicker/issues"
  },
  "homepage": "http://hadabo.github.io/oreo-clicker",
  "dependencies": {
    "gh-pages": "^6.1.1",
    "numeral": "^2.0.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-scripts": "^5.0.1",
    "rxjs": "^7.8.2",
    "simple-crypto-js": "^3.0.1"
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.1",
    "cross-env": "^10.1.0"
  },
  "scripts": {
    "start": "cross-env NODE_OPTIONS='--no-deprecation' craco start",
    "build": "cross-env NODE_OPTIONS='--no-deprecation' craco build",
    "test": "cross-env NODE_OPTIONS='--no-deprecation' craco test",
    "test:coverage": "cross-env NODE_OPTIONS='--no-deprecation' craco test --coverage --watchAll=false",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "lint": "eslint src --ext .js,.jsx --fix",
    "analyze": "npm run build && npx serve -s build"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all",
      "not ie <= 11"
    ],
    "development": [
      "last 2 chrome version",
      "last 2 firefox version",
      "last 2 safari version",
      "last 2 edge version"
    ]
  }
}
